---
/**
 * Renders an image uploaded to the CMS. Payload already generated the resized variants,
 * so this emits a plain <img srcset> instead of processing images at build time.
 * Takes the same props the pages used with astro:assets <Image>.
 */
import type { CmsImage } from '@/lib/cms';
import type { HTMLAttributes } from 'astro/types';

type Props = Omit<HTMLAttributes<'img'>, 'src' | 'alt'> & {
  src: CmsImage | string;
  alt?: string;
};

const { src, alt, width, height, sizes, loading = 'lazy', decoding = 'async', ...rest } = Astro.props;
const img: CmsImage = typeof src === 'string' ? { src } : src;

// Keep the intrinsic aspect ratio when the page only pins one dimension.
const ratio = img.width && img.height ? img.height / img.width : undefined;
const w = width ? Number(width) : height && ratio ? Math.round(Number(height) / ratio) : img.width;
const h = height ? Number(height) : width && ratio ? Math.round(Number(width) * ratio) : img.height;
---
<img
  src={img.src}
  srcset={img.srcset}
  sizes={sizes ?? (img.srcset ? (w ? `(max-width: ${w}px) 100vw, ${w}px` : '100vw') : undefined)}
  alt={alt ?? img.alt ?? ''}
  width={w}
  height={h}
  loading={loading}
  decoding={decoding}
  {...rest}
/>
