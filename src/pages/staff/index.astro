---
import Base from "../../layouts/Base.astro";
import { Image } from "astro:assets";
import SectionNews from "../../components/SectionNews.astro";
import { getCollection } from "astro:content";
import { useTranslations } from "@/i18n/translations";

const staff = await getCollection("staff");
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const t = useTranslations("sl");

const sidebarLinks = [
  { label: "Laboratoriji",      href: `${base}/laboratories` },
  { label: "Interesne skupine", href: `${base}/interest-groups` },
  {
    label: "Osebje",
    href: `${base}/staff`,
    children: staff.map(p => ({
      label: p.data.name,
      href: `${base}/staff/${p.id}`,
      sidebarLevel: "tertiary",
    })),
  },
];

const sections = [
  { key: "predstojnik", label: "Predstojnik inštituta" },
  { key: "profesorji",  label: "Profesorji in predavatelji" },
  { key: "asistenti",   label: "Asistenti in raziskovalci" },
  { key: "tehnicno",    label: "Tehnično osebje" },
  { key: "prejsnji",    label: "Prejšnji člani" },
];

function getSection(member: typeof staff[0]) {
  return member.data.section ?? "profesorji";
}
---
<Base title="Osebje" sidebarLinks={sidebarLinks}>

  <h1 class="page-title">Osebje</h1>
  <div class="page-title-rule"></div>
  <p class="page-subtitle">Akademsko in raziskovalno osebje Inštituta za informatiko</p>

  {sections.map(({ key, label }) => {
    const members = staff.filter(p => getSection(p) === key);
    if (members.length === 0) return null;
    return (
      <section class="staff-section">
        <h2 class="staff-section-title">
          {label}
          {key === "prejsnji" && (
            <button
              class="former-toggle"
              type="button"
              aria-expanded="false"
              aria-controls="former-grid"
              aria-label={t("staff.former.show")}
              data-label-open={t("staff.former.hide")}
              data-label-closed={t("staff.former.show")}
            >
              <span class="former-toggle-icon" aria-hidden="true"></span>
            </button>
          )}
        </h2>
        <div
          id={key === "prejsnji" ? "former-grid" : undefined}
          class:list={["staff-grid", { "staff-grid--hidden": key === "prejsnji" }]}
        >
          {members.map(p => (
            <a href={`${base}/staff/${p.id}`} class="staff-card">
              <div class="staff-avatar">
                {p.data.photo
                  ? <Image src={p.data.photo} alt={p.data.name}  />
                  : <span>{p.data.name.charAt(0)}</span>
                }
              </div>
              <p class="staff-name">{p.data.name}</p>
              {p.data.title && <p class="staff-academic-title">{p.data.title}</p>}
              <p class="staff-role">{p.data.role}</p>
              <div class="staff-divider"></div>
              {p.data.email && <p class="staff-email">{p.data.email}</p>}
            </a>
          ))}
        </div>
      </section>
    );
  })}

  <SectionNews tag="student" label="Zadnje novice" />

<script>
  const btn = document.querySelector(".former-toggle");
  const grid = document.getElementById("former-grid");
  const icon = document.querySelector<HTMLElement>(".former-toggle-icon");

  btn?.addEventListener("click", () => {
    const open = btn.getAttribute("aria-expanded") === "true";
    const nextOpen = !open;
    btn.setAttribute("aria-expanded", String(nextOpen));
    btn.setAttribute(
      "aria-label",
      nextOpen ? btn.dataset.labelOpen ?? "" : btn.dataset.labelClosed ?? ""
    );
    grid?.classList.toggle("staff-grid--hidden", !nextOpen);
    icon?.classList.toggle("is-open", nextOpen);
  });
</script>

</Base>
