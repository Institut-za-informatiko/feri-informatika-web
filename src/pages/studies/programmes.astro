---
import Base from "../../layouts/Base.astro";
import SectionNews from "../../components/SectionNews.astro";
import { getCollection } from "astro:content";

const base = import.meta.env.BASE_URL;
const programmes = await getCollection("studyProgrammes");

const sidebarLinks = [
  {
    label: "Študijski programi",
    href: `${base}/studies/programmes`,
    children: programmes.map(p => ({
      label: p.data.title,
      href: `${base}/studies/programmes/${p.id}`,
      sidebarLevel: "tertiary",
    })),
  },
  { label: "Študentske dejavnosti", href: `${base}/studies/student-projects` },
];
---
<Base title="Študijski programi" sidebarLinks={sidebarLinks}>

  <h1 class="page-title">Študijski programi</h1>
  <div class="page-title-rule"></div>

  <div class="card">
    <div class="intro">
      <p>Inštitut za informatiko je glavni izvajalec izobraževanja v dodiplomskih in podiplomskih študijskih programih »Informatika in podatkovne tehnologije« (IPT) ter »Informacijske in komunikacijske tehnologije« (ITK).</p>
    </div>

    <div class="section-heading"><h3>Na voljo so naslednji programi</h3></div>
    <ul class="arrow-list">
      {programmes.map(p => (
        <li>
          <span class="arrow-icon">
            <svg width="13" height="13" viewBox="0 0 14 14" fill="none">
              <path d="M2 7h10M8 3l4 4-4 4" stroke="#1f2933" stroke-width="1.9"
                    stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
          <a href={`${base}/studies/programmes/${p.id}`}>
            {p.data.title}
            <span style="font-size:0.8rem; color:var(--muted); font-weight:400; margin-left:5px;">
              ({p.data.type} · {p.data.ects} ECTS)
            </span>
          </a>
        </li>
      ))}
      {programmes.length === 0 && <li class="empty-state">Programov še ni na seznamu.</li>}
    </ul>
  </div>

  <SectionNews tag="student" label="Najnovejše novice" />

</Base>
