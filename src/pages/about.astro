---
import Base from "../layouts/Base.astro";
import SectionNews from "../components/SectionNews.astro";
import { getCollection, getEntry, render } from "astro:content";
import { Image } from "astro:assets";
import { readFileSync } from "fs";
import { resolve } from "path";

const base = import.meta.env.BASE_URL;

const sidebarLinks = [
  { label: "Laboratoriji",    href: `${base}/laboratories` },
  { label: "Zainteresirane skupine", href: `${base}/interest-groups` },
  { label: "Osebje",           href: `${base}/staff` },
];

let highlightedNewsIds: string[]        = [];
let highlightedAchievementsIds: string[] = [];
let highlightedProjectsIds: string[]    = [];

try {
  const configPath = resolve("src/content/config/highlighted.json");
  const raw = readFileSync(configPath, "utf-8");
  const config = JSON.parse(raw);
  highlightedNewsIds        = config.news         ?? [];
  highlightedAchievementsIds = config.achievements ?? [];
  highlightedProjectsIds    = config.projects      ?? [];
} catch {
}

function normalizeId(str: string): string {
  return str
    .toLowerCase()
    .replace(/[\u{1F000}-\u{1FFFF}]/gu, '')
    .replace(/[\u{2600}-\u{27BF}]/gu, '')
    .replace(/[»«""''–—]/g, '')
    .replace(/[čć]/g, 'c')
    .replace(/[šś]/g, 's')
    .replace(/[žź]/g, 'z')
    .replace(/\s+/g, '-')
    .replace(/-+/g, '-')
    .replace(/[^\w-]/g, '')
    .trim();
}

function findById<T extends { id: string; slug?: string }>(
  collection: T[],
  ids: string[]
): T[] {
  return ids
    .map(id => {
      const norm = normalizeId(id);
      return collection.find(n =>
        n.id === id ||
        n.slug === id ||
        normalizeId(n.id) === norm ||
        normalizeId(n.slug ?? '') === norm
      );
    })
    .filter(Boolean) as T[];
}

const allNews         = await getCollection("news");
const allAchievements = await getCollection("achievements");
const allProjects     = await getCollection("projects");

const highlightedNews         = findById(allNews, highlightedNewsIds).slice(0, 3);
const highlightedAchievements = findById(allAchievements, highlightedAchievementsIds).slice(0, 3);
const highlightedProjects     = findById(allProjects, highlightedProjectsIds).slice(0, 3);

const aboutEntry = await getEntry("about", "institute");
const { Content } = await render(aboutEntry);
const aboutData = aboutEntry.data;
const hasContact = aboutData.contactEmail || aboutData.contactAddress || aboutData.contactPhone || aboutData.contactWebsite;
---
<Base title="About the Institute" sidebarLinks={sidebarLinks}>

  <h1 class="page-title">{aboutData.title}</h1>
  <div class="page-title-rule"></div>
  {aboutData.subtitle && (
    <p class="page-subtitle">
      {aboutData.subtitle}
    </p>
  )}

  <div class="card">

    <Content />

    {hasContact && (
      <>
        <h2>Kontakt</h2>
        <ul class="contact-info">
          {aboutData.contactEmail && (
            <li><strong>E-pošta:</strong> <a href={`mailto:${aboutData.contactEmail}`}>{aboutData.contactEmail}</a></li>
          )}
          {aboutData.contactAddress && (
            <li><strong>Naslov:</strong> {aboutData.contactAddress}</li>
          )}
          {aboutData.contactPhone && (
            <li><strong>Telefon:</strong> {aboutData.contactPhone}</li>
          )}
          {aboutData.contactWebsite && (
            <li><strong>Splet:</strong> <a href={aboutData.contactWebsite}>{aboutData.contactWebsite.replace(/^https?:\/\//, "")}</a></li>
          )}
        </ul>
      </>
    )}

  </div>
  <SectionNews tag="interest-groups" label="Najnovejše novice" />

</Base>